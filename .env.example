# Kopyahin bilang .env at palitan ang mga value. HUWAG i-commit ang .env.
#
# Bumuo ng bagong secret:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# Minimum 32 characters. Ito ang password sa /operator at sa POST /api/pairing.
BINGO_OPERATOR_API_KEY=REPLACE_WITH_GENERATED_SECRET

# Ang base URL na naka-encode sa QR.
# HUWAG gamitin ang localhost kung phone ang mag-scan — ang phone ang magiging
# localhost at mabibigo. Gamitin ang LAN IP ng dev machine, at i-bind ang
# uvicorn sa --host 0.0.0.0.
#   ipconfig | Select-String IPv4
BINGO_PUBLIC_BASE_URL=http://127.0.0.1:8000

BINGO_DATABASE_URL=sqlite+aiosqlite:///./bingobanano.db
BINGO_PAIRING_TTL_SECONDS=300
BINGO_DEFAULT_CARD_COUNT=2
BINGO_MAX_CARD_COUNT=12
BINGO_PAIRING_RATE_LIMIT_PER_MINUTE=20
BINGO_BINGO_RATE_LIMIT_PER_MINUTE=120
BINGO_LOGIN_RATE_LIMIT_PER_MINUTE=10
BINGO_PHOTO_UPLOAD_RATE_LIMIT_PER_MINUTE=12

# --- Banano Radio (Spotify) ---
# Opsyonal. Kapag blangko ang dalawang ito, patay lang ang Radio at normal pa
# rin ang bingo.
#
# Setup, isang beses lang:
#   1. Pumunta sa https://developer.spotify.com/dashboard at gumawa ng app.
#   2. Idagdag ang Redirect URI na ito, salitang-salita:
#        http://127.0.0.1:8000/operator/radio/callback
#      Loopback address ito nang sadya. Ang `localhost` ay bawal na sa Spotify,
#      at ang `trycloudflare.com` na URL ay nagbabago kada takbo — ang callback
#      ay tumatama lang sa browser ng host, kaya hindi kailangang abot ito ng
#      internet.
#
#      Kung may ngrok dev domain ka (hindi nagbabago iyon), puwede ring iyon.
#      I-register ang PAREHO sa dashboard at palitan lang ang value sa ibaba:
#        https://<ikaw>.ngrok-free.dev/operator/radio/callback
#      Bentahe: puwede kang mag-connect mula sa phone at hindi lang sa makinang
#      tumatakbo ang server. Buksan muna ang /operator sa ngrok URL para
#      malampasan ang warning page ng ngrok bago mag-connect.
#   3. Kopyahin ang Client ID at Client Secret dito.
#
# Kailangan ng Spotify PREMIUM ang account ng host. Ang add-to-queue endpoint ay
# hindi tumatakbo sa libreng account, at kailangan din ito ng Spotify sa may-ari
# ng isang Development Mode na app.
#
# Ang mga BISITA ay HINDI nangangailangan ng Spotify account. Isa lang ang
# kumakabit sa Spotify — ang host.
BINGO_SPOTIFY_CLIENT_ID=
BINGO_SPOTIFY_CLIENT_SECRET=
BINGO_SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/operator/radio/callback

BINGO_RADIO_SEARCH_RATE_LIMIT_PER_MINUTE=30
BINGO_RADIO_REQUEST_RATE_LIMIT_PER_MINUTE=10
# Ilang segundo bago makapag-request muli ang parehong bisita.
BINGO_RADIO_REQUEST_COOLDOWN_SECONDS=120
BINGO_RADIO_MAX_TRACK_SECONDS=600
BINGO_RADIO_DUPLICATE_WINDOW_MINUTES=60
BINGO_RADIO_NOW_PLAYING_CACHE_SECONDS=5
